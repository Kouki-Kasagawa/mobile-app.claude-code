# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# editor / tool configs
.vscode/
.claude/

# local env files
.env*.local

# typescript
*.tsbuildinfo

app-example

# generated native folders
/mobile/ios
/mobile/android

# ==== Secrets / credentials (追加: 機密情報の取りこぼし防止) ====
# すべての env ファイルを除外（説明用の *.example だけ残す）
.env
.env.*
!.env.example
!.env.*.example

# Claude / エディタのローカル上書き設定
.claude/settings.local.json
.claude/*.local.json

# クラウド認証情報・鍵ファイル
**/serviceAccount*.json
google-services.json
GoogleService-Info.plist
*.keystore

# 汎用の秘密ファイル
secrets/
*.secret
credentials*.json

# 調査資料（論文など著作権のあるもの。公開しない）
/research/
